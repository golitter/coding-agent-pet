#!/usr/bin/env sh
# Cross-platform pre-commit entrypoint.
# On Windows Git Bash/MSYS/Cygwin, delegate to the PowerShell implementation.

case "$(uname -s 2>/dev/null)" in
  MINGW*|MSYS*|CYGWIN*)
    dir="$(dirname "$0")"
    if command -v pwsh >/dev/null 2>&1; then
      pwsh -NoProfile -File "$dir/pre-commit.ps1"
      exit $?
    elif command -v powershell >/dev/null 2>&1; then
      powershell -NoProfile -ExecutionPolicy Bypass -File "$dir/pre-commit.ps1"
      exit $?
    fi
    ;;
esac

repo_root=$(git rev-parse --show-toplevel) || exit 1
cd "$repo_root/desktop/cross-platform" || exit 1

# Frontend: Prettier + ESLint through lint-staged.
npx lint-staged || exit 1

# Rust: fmt check, all files because cargo fmt has no staged-only mode.
cd src-tauri || exit 1
cargo fmt --check --quiet 2>/dev/null
if [ $? -ne 0 ]; then
  echo "cargo fmt check failed. Run 'cargo fmt' in src-tauri/ to fix."
  exit 1
fi
cd ..

# Shell: shellcheck, only staged .sh files.
staged_sh=$(git diff --cached --name-only --diff-filter=ACM -- '*.sh' ':!node_modules')
if [ -n "$staged_sh" ]; then
  staged_sh_abs=$(printf '%s\n' "$staged_sh" | sed "s|^|$repo_root/|")
  shellcheck $staged_sh_abs
fi

# Python: ruff, only staged .py files.
staged_py=$(git diff --cached --name-only --diff-filter=ACM -- '*.py' ':!node_modules')
if [ -n "$staged_py" ]; then
  staged_py_abs=$(printf '%s\n' "$staged_py" | sed "s|^|$repo_root/|")
  if python3 -m ruff --version >/dev/null 2>&1; then
    python3 -m ruff check $staged_py_abs || exit 1
  elif python -m ruff --version >/dev/null 2>&1; then
    python -m ruff check $staged_py_abs || exit 1
  elif command -v ruff >/dev/null 2>&1; then
    ruff check $staged_py_abs || exit 1
  else
    echo "ruff not installed. Install: pip install ruff"
  fi
fi
