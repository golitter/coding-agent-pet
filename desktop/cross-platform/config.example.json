{
  "_comment": "Copy this file to config.json and customize. Null values are auto-detected.",
  "pet_id": "kotori-minami",
  "pet_base_dir": null,
  "frames_dir": null,
  "socket_path": "/tmp/kotori-pet.sock",
  "sessions_dir": null,
  "renderer": {
    "scale": 0.6,
    "fps": 10,
    "stale_timeout_sec": 60,
    "cleanup_interval_sec": 5,
    "corner_margin": 20
  },
  "dialogue": {
    "font_size": 10,
    "max_width": 160,
    "cornerRadius": 6,
    "fade_duration_sec": 0.3
  },
  "hooks": {
    "claude_code_settings": "~/.claude/settings.json",
    "codex_hooks": "~/.codex/hooks.json"
  },
  "terminal_events": ["StopFailure", "SessionEnd"],
  "state_map": {
    "SessionStart": { "state": "waving", "dialogue": "嗨！小鸟来啦～" },
    "UserPromptSubmit": { "state": "running", "dialogue": "收到！开始工作～" },
    "PreToolUse": { "state": "running", "dialogue": "执行中..." },
    "Stop": { "state": "jumping", "dialogue": "搞定啦！✨" },
    "StopFailure": { "state": "failed", "dialogue": "呜...出了点问题" },
    "Notification": { "state": "waving", "dialogue": "注意哦～" },
    "PermissionRequest": { "state": "waiting", "dialogue": "需要你的授权～" },
    "SubagentStop": { "state": "idle", "dialogue": "" },
    "PreCompact": { "state": "waiting", "dialogue": "整理一下记忆..." },
    "SessionEnd": { "state": "waving", "dialogue": "下次见！♪" }
  },
  "menu": {
    "items": [
      {
        "title": "Codex",
        "action": "applescript",
        "script": "tell application \"Codex\"\nactivate\nend tell"
      },
      {
        "title": "VS Code",
        "action": "applescript",
        "script": "tell application \"Visual Studio Code\"\nactivate\nend tell"
      },
      { "type": "separator" },
      { "title": "关闭宠物", "action": "quit" }
    ]
  }
}
